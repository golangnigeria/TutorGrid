# TutorGrid Local Development Environment (go-boilerplate + Limen + pgx/tern + Asynq + New Relic + Resend)
# Copy to .env (gitignored) and populate real values locally. Never commit real secrets.

TUTORGRID_PRIMARY.ENV=development
TUTORGRID_SERVER.PORT=8080
TUTORGRID_SERVER.READ_TIMEOUT=30
TUTORGRID_SERVER.WRITE_TIMEOUT=30
TUTORGRID_SERVER.IDLE_TIMEOUT=60
TUTORGRID_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:5173

TUTORGRID_DATABASE.HOST=localhost
TUTORGRID_DATABASE.PORT=5432
TUTORGRID_DATABASE.USER=tutorgrid_app
TUTORGRID_DATABASE.PASSWORD=tutorgrid_app_dev
TUTORGRID_DATABASE.NAME=tutorgrid
TUTORGRID_DATABASE.SSL_MODE=disable
TUTORGRID_DATABASE.MAX_OPEN_CONNS=10
TUTORGRID_DATABASE.MAX_IDLE_CONNS=5
TUTORGRID_DATABASE.CONN_MAX_LIFETIME=300
TUTORGRID_DATABASE.CONN_MAX_IDLE_TIME=300

TUTORGRID_REDIS.ADDRESS=localhost:6379

# Limen Auth & OAuth (Google + GitHub only — keep your real values in local gitignored .env)
TUTORGRID_APP_BASE_URL=http://localhost:8080
TUTORGRID_FRONTEND_BASE_URL=http://localhost:5173
TUTORGRID_LIMEN_SECRET=
TUTORGRID_GOOGLE_CLIENT_ID=
TUTORGRID_GOOGLE_CLIENT_SECRET=
TUTORGRID_GITHUB_CLIENT_ID=
TUTORGRID_GITHUB_CLIENT_SECRET=

# Required External API Keys (configure real values in local gitignored .env before running)
TUTORGRID_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=
TUTORGRID_OBSERVABILITY.NEW_RELIC.USER_KEY=
TUTORGRID_INTEGRATION.RESEND_API_KEY=

TUTORGRID_INTEGRATION.FROM_EMAIL=onboarding@resend.dev
TUTORGRID_INTEGRATION.FROM_NAME=TutorGrid Circle
TUTORGRID_INTEGRATION.APP_NAME="TutorGrid"
TUTORGRID_INTEGRATION.TEMPLATES_DIR="templates/emails"