# TutorGrid Local Development Environment (Slice 1)
# Never commit real secrets.

APP_ENV=development
HTTP_ADDR=:8080

# Non-superuser runtime role (NOSUPERUSER NOBYPASSRLS)
DATABASE_URL=postgres://tutorgrid_app:tutorgrid_app_dev@localhost:5432/tutorgrid?sslmode=disable

# Migrator role used exclusively by Goose migrations
DATABASE_MIGRATION_URL=postgres://tutorgrid_migrator:tutorgrid_migrator_dev@localhost:5432/tutorgrid?sslmode=disable

# Isolated test database URLs for integration tests
TEST_DATABASE_URL=postgres://tutorgrid_app:tutorgrid_app_dev@localhost:5432/tutorgrid_test?sslmode=disable
TEST_DATABASE_MIGRATION_URL=postgres://tutorgrid_migrator:tutorgrid_migrator_dev@localhost:5432/tutorgrid_test?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
SHUTDOWN_TIMEOUT=10s
