# TutorGrid Local Development Environment
# Copy this file to .env (gitignored) and populate real values locally.
# Never commit real secrets.

TUTORGRID_APP_ENV=development
TUTORGRID_HTTP_ADDR=:8080
TUTORGRID_APP_BASE_URL=http://localhost:8080
TUTORGRID_FRONTEND_BASE_URL=http://localhost:5173

# Non-superuser runtime role (NOSUPERUSER NOBYPASSRLS)
TUTORGRID_DATABASE_URL=postgres://tutorgrid_app:tutorgrid_app_dev@localhost:5432/tutorgrid?sslmode=disable

# Migrator role used exclusively by Goose migrations
TUTORGRID_DATABASE_MIGRATION_URL=postgres://tutorgrid_migrator:tutorgrid_migrator_dev@localhost:5432/tutorgrid?sslmode=disable

# Isolated test database URLs for integration tests
TUTORGRID_TEST_DATABASE_URL=postgres://tutorgrid_app:tutorgrid_app_dev@localhost:5432/tutorgrid_test?sslmode=disable
TUTORGRID_TEST_DATABASE_MIGRATION_URL=postgres://tutorgrid_migrator:tutorgrid_migrator_dev@localhost:5432/tutorgrid_test?sslmode=disable

TUTORGRID_DB_MAX_OPEN_CONNS=10
TUTORGRID_DB_MAX_IDLE_CONNS=5
TUTORGRID_DB_CONN_MAX_LIFETIME=30m
TUTORGRID_SHUTDOWN_TIMEOUT=10s

# Limen Auth & OAuth (configure real values in local gitignored .env only)
TUTORGRID_LIMEN_SECRET=
TUTORGRID_GOOGLE_CLIENT_ID=
TUTORGRID_GOOGLE_CLIENT_SECRET=
TUTORGRID_GITHUB_CLIENT_ID=
TUTORGRID_GITHUB_CLIENT_SECRET=
